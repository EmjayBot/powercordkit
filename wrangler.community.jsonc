{
  // COMMUNITY DEPLOY — the Mail inbox Worker + D1 + static UI.
  // Fill in your own values, then: wrangler login (your account), db:create,
  // migrate, secrets, deploy. Full walkthrough: AI_SETUP.md / /mail-setup/.
  // Keep a private copy of your filled-in values in wrangler.community.local.jsonc
  // (gitignored) so you can pull template updates without losing your config.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "powercordkit-community",
  "main": "src/index.ts",
  // Preserve dashboard-added bindings across deploys.
  "keep_vars": true,
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hooks/*"]
  },
  "triggers": {
    "crons": ["0 3 * * *", "*/2 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "community",
    // Your public host — used for login redirects and links (custom domain).
    "COMMUNITY_DOMAIN": "mail.example.com",
    // Slug for items mailed without a server.
    "DEFAULT_SERVER": "main",
    // "1" = public roadmap, "0" = login required.
    "PUBLIC_ROADMAP": "1"
    // Also add here (see AI_SETUP.md): DISCORD_CLIENT_ID, DISCORD_GUILD_ID,
    // DISCORD_MOD_ROLE_IDS, DISCORD_PUBLIC_KEY, optional DISCORD_IDEA_ROLE_IDS,
    // and FEED_MAP for the poller.
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "powercordkit-mail-community",
      // Paste the id printed by `npm run db:create:community`.
      "database_id": "REPLACE_WITH_YOUR_D1_ID",
      "migrations_dir": "./migrations"
    }
  ]
  // Custom domain (optional): add once the zone is in your account:
  // "routes": [{ "pattern": "mail.example.com/*", "zone_name": "example.com" }]
}
