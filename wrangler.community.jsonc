{
  // COMMUNITY DEPLOY — separate Cloudflare account (TEP community).
  // Use with: wrangler <cmd> --config wrangler.community.jsonc
  // (npm run dev:community / deploy:community already pass --config for you)
  // Login flow: wrangler logout && wrangler login  (as community account),
  // then db:create:community, paste database_id below, migrate, secrets, deploy.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "powercordkit-community",
  "main": "src/index.ts",
  // Preserve dashboard-added bindings across deploys. Without this, a
  // `wrangler deploy` replaces dashboard plaintext vars with config vars,
  // which silently deletes anything added in the dashboard.
  "keep_vars": true,
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Pinned to the TEP community account (via wrangler whoami as webmaster@tep.network).
  "account_id": "7481a12e1f66bd216d224fb93ff3ec82",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hooks/*"]
  },
  "triggers": {
    "crons": ["0 3 * * *", "*/2 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "community",
    "COMMUNITY_ID": "tep",
    "PERSONAL_DOMAIN": "powercordkit.emjay.fyi",
    "COMMUNITY_DOMAIN": "mod.tep.one",
    "DEFAULT_SERVER": "tep.one",
    "PUBLIC_ROADMAP": "1",
    "DISCORD_CLIENT_ID": "1557873013309833369",
    "DISCORD_GUILD_ID": "633351482128728064",
    "DISCORD_MOD_ROLE_IDS": "633351965761339392,1150260858748932198,633353998287503390",
    "DISCORD_IDEA_ROLE_IDS": "633352531690520596",
    "DISCORD_PUBLIC_KEY": "75760898576bd1e5e536a7c8953a244194627b004ad4d2c26bfd9baa96019d50",
    "FEED_MAP": "{\"channels\":[{\"guild\":\"508790398873894915\",\"channel\":\"511665989210079252\",\"server\":\"tep-urth\",\"type\":\"ticket\"},{\"guild\":\"508790398873894915\",\"channel\":\"1252432781653315634\",\"server\":\"tep-urth\",\"type\":\"ticket\"}],\"threads\":[{\"guild\":\"633351482128728064\",\"parent\":\"894920335139409983\",\"server\":\"the-east-pacific\",\"type\":\"ticket\"},{\"guild\":\"633351482128728064\",\"parent\":\"1114601767724920893\",\"server\":\"the-east-pacific\",\"type\":\"support\"}]}"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "powercordkit-mail-community",
      "database_id": "ef8e3c4e-38db-47bf-8ebb-c34be00d0a67",
      "migrations_dir": "./migrations"
    }
  ],
  // Custom domain: active — tep.one zone lives in this (community) account.
  "routes": [{ "pattern": "mod.tep.one/*", "zone_name": "tep.one" }]
}
