{
  // TOOLS-ONLY SITE — serves the built static labs. No D1, no secrets.
  // Build + deploy: npm run deploy:tools  (after `wrangler login`).
  // Keep your own values in wrangler.tools.local.jsonc (gitignored).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "powercordkit-tools",
  "main": "src/tools.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist/tools",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ENVIRONMENT": "tools"
  }
  // Custom domain (optional): "routes": [{ "pattern": "tools.example.com/*", "zone_name": "example.com" }]
}
