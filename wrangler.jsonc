{
  // PERSONAL DEPLOY — a solo instance. Fill in your own values; keep a private
  // copy in wrangler.local.jsonc (gitignored). See AI_SETUP.md.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "powercordkit",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hooks/*"]
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "personal",
    "DEFAULT_SERVER": "general"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "powercordkit-mail",
      // Paste the id printed by `npm run db:create`.
      "database_id": "REPLACE_WITH_YOUR_D1_ID",
      "migrations_dir": "./migrations"
    }
  ]
  // Custom domain (optional): "routes": [{ "pattern": "mail.example.com/*", "zone_name": "example.com" }]
}
